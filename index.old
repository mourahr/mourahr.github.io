        h3 {
        border-bottom: 2px solid #00d8ff;
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
        }
        a {
        color: #00d8ff;
        text-decoration: none;
        }
        a:hover {
        text-decoration: underline;
        }
        form input, form textarea {
        width: 100%;
        padding: 0.75rem;
        margin-bottom: 1rem;
        border: none;
        border-radius: 8px;
        }
    </style>
</head>
